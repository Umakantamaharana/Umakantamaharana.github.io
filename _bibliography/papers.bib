@misc{sanyal2025pedagogical,
      title={Investigating Pedagogical Teacher and Student LLM Agents: Genetic Adaptation Meets Retrieval Augmented Generation Across Learning Style}, 
      author={Debdeep Sanyal and Agniva Maiti and Umakanta Maharana and Dhruv Kumar and Ankur Mali and C. Lee Giles and Murari Mandal},
      year={2025},
      eprint={2505.19173},
      archivePrefix={arXiv},
      primaryClass={cs.AI},
      url={https://arxiv.org/abs/2505.19173}, 
      pdf={https://arxiv.org/pdf/2505.19173.pdf},
      arxiv={2505.19173},
      abstract={Effective teaching requires adapting instructional strategies to accommodate the diverse cognitive and behavioral profiles of students, a persistent challenge in education and teacher training. We introduce a novel simulation framework that integrates LLM-based heterogeneous student agents with a self-optimizing teacher agent whose pedagogical policy dynamically evolves using a genetic algorithm. In addition, we propose Persona-RAG, a Retrieval Augmented Generation module that enables student agents to retrieve knowledge tailored to their individual learning styles.},
      keywords={Pedagogical Agents, LLM, Multi-Agent Simulation, Retrieval-Augmented Generation, Genetic Algorithm},
      journal={arXiv preprint arXiv:2505.19173},
      selected={true},
}



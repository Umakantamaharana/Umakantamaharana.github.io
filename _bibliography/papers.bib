@misc{maharana2025rightpredictionwrongreasoning,
      abbr={Preprint},
      bibtex_show={true},
      title={Right Prediction, Wrong Reasoning: Uncovering LLM Misalignment in RA Disease Diagnosis}, 
      author={Umakanta Maharana and Sarthak Verma and Avarna Agarwal and Prakashini Mruthyunjaya and Dwarikanath Mahapatra and Sakir Ahmed and Murari Mandal},
      year={2025},
      eprint={2504.06581},
      archivePrefix={arXiv},
      primaryClass={cs.AI},
      url={https://arxiv.org/abs/2504.06581}, 
      note={Under review. Investigating the implications of LLM misalignment and reasoning faithfulness in medical diagnostics.},
      preview={rpwr.png},
      pdf={https://arxiv.org/pdf/2504.06581.pdf},
      arxiv={2504.06581},
      blog={/blog/2025/right-prediction-wrong-reasoning/},
      abstract={Large Language Models (LLMs) frequently achieve high classification accuracy on clinical diagnosis benchmarks while relying on medically flawed or hallucinated reasoning steps. This study evaluates diagnostic justifications generated by LLMs for Rheumatoid Arthritis (RA) against blinded clinical rheumatology experts, demonstrating that high benchmark accuracy can be deceptive and dangerous in real-world clinical deployment.},
      keywords={LLM misalignment, RA disease diagnosis, medical diagnostics, AI ethics, machine learning},
      journal={arXiv preprint arXiv:2504.06581},
      selected={true},
}

